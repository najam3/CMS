PORT=3000
CLIENT_ORIGINS=http://localhost:3001

# Use DATABASE_URL for hosted Postgres, or the individual DB_* values locally.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Replace with a long, random value. Keep this only in the server environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
